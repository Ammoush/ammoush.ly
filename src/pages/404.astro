---
import Base from "../layouts/Base.astro";
import { profile } from "../lib/profile";

const { not_found: copy } = profile;
---

<Base lang="en" title={`${copy.title.en} | ${profile.person.name.en}`} indexable={false}>
  <section class="not-found tone-light">
    <div class="shell">
      <div>
        <h1>{copy.title.en}</h1>
        <p>{copy.body.en}</p>
        <a class="button button-primary" href="/">{copy.back.en}</a>
      </div>
      <div lang="ar" dir="rtl">
        <h2>{copy.title.ar}</h2>
        <p>{copy.body.ar}</p>
        <a class="button button-secondary" href="/ar/">{copy.back.ar}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: calc(100svh - var(--header-h) - 5rem);
    display: flex;
    align-items: center;
  }

  .shell {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  h1,
  h2 {
    font-size: var(--step-4);
    line-height: 1.05;
  }

  [lang="ar"] {
    font-family: var(--font-arabic), var(--font-latin);
  }

  [lang="ar"] h2 {
    line-height: 1.3;
  }

  p {
    margin-block: var(--space-4) var(--space-6);
    color: var(--fg-muted);
    font-size: var(--step-1);
  }
</style>
