---
// Three stacked bars that read as an A, the same bars as the reconciliation panel.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 44 44" fill="currentColor" aria-hidden="true">
  <rect x="17" y="7" width="10" height="6" rx="3"></rect>
  <rect x="11" y="18" width="22" height="6" rx="3"></rect>
  <rect x="5" y="29" width="34" height="6" rx="3"></rect>
</svg>
