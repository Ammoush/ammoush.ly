---
import { profile, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { contact, contact_section: section, ui } = profile;
const { actions } = section;
const whatsapp = `https://wa.me/${contact.phone.replace("+", "")}`;
const pretty = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

const channels = [
  { label: ui.email[lang], value: contact.email, href: `mailto:${contact.email}`, copy: true },
  { label: actions.whatsapp[lang], value: contact.phone_display, href: whatsapp },
  { label: actions.linkedin[lang], value: pretty(contact.linkedin), href: contact.linkedin },
  ...(contact.github ? [{ label: actions.github[lang], value: pretty(contact.github), href: contact.github }] : []),
];
---

<section class="contact tone-dark" id="contact" aria-labelledby="contact-heading">
  <div class="shell section">
    <div class="intro">
      <h2 id="contact-heading">{section.heading[lang]}</h2>
      <p>{section.body[lang]}</p>
    </div>

    <div class="channels">
      <ul>
        {
          channels.map((ch) => (
            <li>
              <span class="label">{ch.label}</span>
              <a class="value" href={ch.href} rel={ch.copy ? undefined : "me noopener"} target={ch.copy ? undefined : "_blank"} dir="ltr">
                {ch.value}
              </a>
              {ch.copy ? (
                <button class="action" type="button" data-copy={ch.value} data-label={actions.copy[lang]} data-done={actions.copied[lang]} aria-label={`${actions.copy[lang]}: ${ch.value}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="8" y="8" width="12" height="12" rx="2" />
                    <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                  </svg>
                  <span>{actions.copy[lang]}</span>
                </button>
              ) : (
                <a class="action" href={ch.href} rel="me noopener" target="_blank" aria-label={`${actions.open[lang]}: ${ch.label}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                  <span>{actions.open[lang]}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="files">
        <a class="button button-secondary" href="/ahmed-ammoush.vcf" download>{actions.save_contact[lang]}</a>
        {
          contact.cv && (
            <a class="button button-secondary" href={contact.cv} download="Ahmed-Ammoush-CV.pdf">
              {actions.download_cv[lang]}
            </a>
          )
        }
      </div>
    </div>

    <p class="visually-hidden" aria-live="polite" data-copy-status></p>
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-7);
    align-items: start;
  }

  .intro {
    grid-column: 1 / span 5;
  }

  .channels {
    grid-column: 7 / -1;
  }

  .intro h2 {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .intro p {
    margin-block-start: var(--space-5);
    max-width: 36ch;
    font-size: var(--step-1);
    color: var(--fg-muted);
  }

  ul {
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--rule);
  }

  li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-4);
    min-height: 4rem;
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }

  .label {
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .value {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .value:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--fg-muted);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .action:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .action svg {
    width: 1rem;
    height: 1rem;
  }

  .files {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  @media (max-width: 63.99rem) {
    .intro,
    .channels {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 39.99rem) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "label action"
        "value action";
      row-gap: var(--space-1);
    }

    .label {
      grid-area: label;
    }

    .value {
      grid-area: value;
    }

    .action {
      grid-area: action;
    }

    .action span {
      display: none;
    }

    .action {
      width: 2.25rem;
      padding: 0;
      justify-content: center;
    }
  }
</style>
