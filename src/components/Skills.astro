---
import { profile, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { skills } = profile;
---

<section class="skills tone-dark" id="skills" aria-labelledby="skills-heading">
  <div class="shell section section-grid">
    <h2 class="section-heading" id="skills-heading">{skills.heading[lang]}</h2>

    <div class="section-body groups">
      {
        skills.groups.map((group) => (
          <div class="group">
            <h3>{group.name[lang]}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item[lang]}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  @media (max-width: 39.99rem) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .group h3 {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--fg);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .group ul {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--fg-muted);
  }
</style>
