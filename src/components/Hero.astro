---
import { profile, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { person, hero, contact } = profile;
const c = hero.console;
---

<section class="hero tone-light" id="top" aria-labelledby="hero-name">
  <div class="shell">
    <div class="intro">
      <p class="location">{person.location[lang]}</p>
      <h1 class="name" id="hero-name">{person.name[lang]}</h1>
      <p class="role">{person.title[lang]}</p>
      <p class="tagline">{hero.tagline[lang]}</p>
      <div class="actions">
        <a class="button button-primary" href="#contact">{hero.cta_primary[lang]}</a>
        <a class="button button-secondary" href={contact.linkedin} rel="me noopener" target="_blank">
          {hero.cta_secondary[lang]}
        </a>
      </div>
    </div>

    <div class="console" data-console>
      <div class="console-head">
        <div>
          <p class="console-title">{c.title[lang]}</p>
          <p class="console-sub">{c.subtitle[lang]}</p>
        </div>
        <div class="console-state">
          <span class="done">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="m3.5 8.5 3 3 6-7"></path>
            </svg>
            {c.done[lang]}
          </span>
          <button class="rerun" type="button" data-rerun>{c.rerun[lang]}</button>
        </div>
      </div>

      {/* Illustrative only: bars show relative alignment, not real figures. */}
      <div class="grid" role="img" aria-label={c.label[lang]}>
        <span aria-hidden="true"></span>
        <span class="col" aria-hidden="true">{c.left[lang]}</span>
        <span class="col" aria-hidden="true">{c.right[lang]}</span>
        <span aria-hidden="true"></span>

        {
          c.rows.map((row) => (
            <>
              <span class="row-label" aria-hidden="true">{row[lang]}</span>
              <span class="track" aria-hidden="true"><i class="bar bar-left" /></span>
              <span class="track" aria-hidden="true"><i class="bar bar-right" /></span>
              <span class="status" aria-hidden="true">
                <b class="bad">{c.mismatch[lang]}</b>
                <b class="ok">{c.matched[lang]}</b>
              </span>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Runs the reconciliation once the panel is on screen, and again on request.
  // Without this script the panel simply shows the reconciled state.
  const panel = document.querySelector<HTMLElement>("[data-console]");

  function run() {
    if (!panel) return;
    panel.classList.remove("run");
    void panel.offsetWidth;
    panel.classList.add("run");
  }

  if (panel) {
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        run();
        seen.disconnect();
      },
      { threshold: 0.4 },
    );
    seen.observe(panel);
    panel.querySelector("[data-rerun]")?.addEventListener("click", run);
  }
</script>

<style>
  .hero {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
  }

  .shell {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    column-gap: var(--space-6);
    row-gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .intro {
    grid-column: 1 / span 5;
  }

  .console {
    grid-column: 6 / -1;
  }

  .location {
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .name {
    margin-block-start: var(--space-3);
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
  }

  :global(:lang(ar)) .name {
    line-height: 1.2;
  }

  .role {
    margin-block-start: var(--space-4);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
  }

  .tagline {
    margin-block-start: var(--space-5);
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  /* Reconciliation panel: the one rich moment on the first screen. */

  .console {
    padding: var(--space-6) var(--space-7) var(--space-7);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgb(10 17 29 / 0.06),
      0 24px 48px -24px rgb(10 17 29 / 0.28);
  }

  .console-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }

  .console-title {
    font-size: var(--step-1);
    font-weight: 500;
  }

  .console-sub {
    margin-block-start: var(--space-1);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .console-state {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    font-size: var(--step--1);
  }

  .done {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-weight: 500;
  }

  .done svg {
    width: 1rem;
    height: 1rem;
  }

  .rerun {
    white-space: nowrap;
    padding: var(--space-1) 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .rerun:hover {
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) minmax(0, 1fr) 7.5rem;
    grid-auto-rows: 3.75rem;
    align-items: center;
    column-gap: var(--space-5);
    margin-block-start: var(--space-3);
  }

  .col {
    align-self: end;
    padding-block-end: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .row-label {
    font-weight: 500;
  }

  .track {
    display: block;
    height: 0.625rem;
    border-radius: 5px;
    background: color-mix(in oklab, var(--fg) 7%, transparent);
    overflow: hidden;
  }

  .bar {
    display: block;
    height: 100%;
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(var(--to));
  }

  :global([dir="rtl"]) .bar {
    transform-origin: right;
  }

  .bar-left {
    background: color-mix(in oklab, var(--fg) 38%, transparent);
  }

  .bar-right {
    background: var(--accent);
  }

  /*
   * Grid children: 4 header cells, then label / left / right / status per row.
   * Per row: the left length, where the right side starts before reconciling, and when it runs.
   */
  .grid > :nth-child(n + 5):nth-child(-n + 8) {
    --to: 0.82;
    --from: 0.66;
    --delay: 600ms;
  }
  .grid > :nth-child(n + 9):nth-child(-n + 12) {
    --to: 0.6;
    --from: 0.76;
    --delay: 1300ms;
  }
  .grid > :nth-child(n + 13):nth-child(-n + 16) {
    --to: 0.9;
    --from: 0.78;
    --delay: 2000ms;
  }

  .status {
    display: grid;
    justify-items: end;
  }

  .status b {
    grid-area: 1 / 1;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .bad {
    color: var(--warn);
    background: var(--warn-tint);
    opacity: 0;
  }

  .ok {
    color: var(--accent);
    background: var(--ok-tint);
  }

  /* The reconciled state is the default; motion only replays how it got there. */
  @media (prefers-reduced-motion: no-preference) {
    .run .bar-right {
      animation: reconcile 700ms var(--ease-out) var(--delay) both;
    }

    .run .bad {
      animation: shown 1ms linear calc(var(--delay) + 650ms) reverse both;
    }

    .run .ok {
      animation: arrive 300ms var(--ease-out) calc(var(--delay) + 650ms) both;
    }

    .run .done {
      animation: arrive 400ms var(--ease-out) 2900ms both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rerun {
      display: none;
    }
  }

  @keyframes reconcile {
    from {
      transform: scaleX(var(--from));
      background: var(--warn);
    }
  }

  @keyframes shown {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
  }

  @media (max-width: 63.99rem) {
    .intro,
    .console {
      grid-column: 1 / -1;
    }

    .hero {
      align-items: flex-start;
    }
  }

  @media (max-width: 39.99rem) {
    .console {
      padding: var(--space-5);
    }

    .grid {
      grid-template-columns: 4.75rem minmax(0, 1fr) minmax(0, 1fr) auto;
      grid-auto-rows: 3.25rem;
      column-gap: var(--space-3);
    }

    .status b {
      padding-inline: 0.5rem;
    }
  }
</style>
