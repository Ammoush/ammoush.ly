---
import { profile, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { person, hero, contact } = profile;
const c = hero.console;
---

<section class="hero tone-light" id="top" aria-labelledby="hero-name">
  <canvas data-backdrop aria-hidden="true"></canvas>
  <div class="shell">
    <div class="intro">
      <p class="location">{person.location[lang]}</p>
      <h1 class="name" id="hero-name">{person.name[lang]}</h1>
      <p class="role">{person.title[lang]}</p>
      <p class="tagline">{hero.tagline[lang]}</p>
      <div class="actions">
        <a class="button button-primary" href="#contact">{hero.cta_primary[lang]}</a>
        <a class="button button-secondary" href={contact.linkedin} rel="me noopener" target="_blank">
          {hero.cta_secondary[lang]}
        </a>
      </div>
      {
        contact.cv && (
          <a class="cv-link" href={contact.cv} download="Ahmed-Ammoush-CV.pdf">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M8 2.5v8m0 0 3-3m-3 3-3-3M3 13.5h10"></path>
            </svg>
            {profile.contact_section.actions.download_cv[lang]}
          </a>
        )
      }
    </div>

    {/* Illustrative only: one change moving through the three gates. */}
    <div class="console" data-console role="group" aria-label={c.label[lang]}>
      <div class="console-head">
        <div>
          <p class="console-title">{c.title[lang]}</p>
          <p class="console-sub">{c.subtitle[lang]}</p>
        </div>
        <div class="console-state">
          <span class="done">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="m3.5 8.5 3 3 6-7"></path>
            </svg>
            {c.done[lang]}
          </span>
          <button class="rerun" type="button" data-rerun>{c.rerun[lang]}</button>
        </div>
      </div>

      <div class="journey">
        <div class="rail" aria-hidden="true">
          <i class="seg seg-1"></i>
          <i class="seg seg-2"></i>
          <i class="dot"></i>
        </div>

        <ol class="gates">
          {
            c.gates.map((gate, i) => (
              <li class="gate">
                <button type="button" aria-describedby={`gate-detail-${i + 1}`}>
                  <span class="ring" aria-hidden="true">
                    <b>{i + 1}</b>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="m3.5 8.5 3 3 6-7"></path>
                    </svg>
                  </span>
                  <span class="gate-name">{gate.name[lang]}</span>
                  <span class="gate-state">{gate.state[lang]}</span>
                  <span class="passed" aria-hidden="true">{c.passed[lang]}</span>
                </button>
              </li>
            ))
          }
        </ol>

        <div class="details">
          {c.gates.map((gate, i) => <p id={`gate-detail-${i + 1}`}>{gate.detail[lang]}</p>)}
        </div>
      </div>

      <p class="summary">
        <span class="count" aria-hidden="true"></span>
        <span class="visually-hidden">{c.gates.length}</span>
        {c.summary[lang].replace("{total}", String(c.gates.length))}
        <span class="hint">{c.hint[lang]}</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Runs the journey once the panel is on screen, and again on request.
  // Without this script the panel simply shows the delivered state.
  const panel = document.querySelector<HTMLElement>("[data-console]");

  function run() {
    if (!panel) return;
    panel.classList.remove("run");
    void panel.offsetWidth;
    panel.classList.add("run");
  }

  if (panel) {
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        run();
        seen.disconnect();
      },
      { threshold: 0.4 },
    );
    seen.observe(panel);
    panel.querySelector("[data-rerun]")?.addEventListener("click", run);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
  }

  canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1200ms var(--ease-out);
  }

  canvas.is-live {
    opacity: 1;
  }

  .shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    column-gap: var(--space-6);
    row-gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .intro {
    grid-column: 1 / span 5;
  }

  .console {
    grid-column: 6 / -1;
  }

  .location {
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .name {
    view-transition-name: hero-name;
    margin-block-start: var(--space-3);
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
  }

  :global(:lang(ar)) .name {
    line-height: 1.2;
  }

  .role {
    margin-block-start: var(--space-4);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
  }

  .tagline {
    margin-block-start: var(--space-5);
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    color: var(--fg-muted);
    font-size: var(--step--1);
    text-underline-offset: 0.25em;
  }

  .cv-link:hover {
    color: var(--fg);
  }

  .cv-link svg {
    width: 1rem;
    height: 1rem;
  }

  /* The change journey panel: the one rich moment on the first screen. */

  .console {
    view-transition-name: hero-console;
    padding: var(--space-6) var(--space-7) var(--space-7);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgb(10 17 29 / 0.06),
      0 24px 48px -24px rgb(10 17 29 / 0.28);
  }

  .console-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }

  .console-title {
    font-size: var(--step-1);
    font-weight: 500;
  }

  .console-sub {
    margin-block-start: var(--space-1);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .console-state {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    font-size: var(--step--1);
  }

  .done {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-weight: 500;
  }

  .done svg {
    width: 1rem;
    height: 1rem;
  }

  .rerun {
    white-space: nowrap;
    padding: var(--space-1) 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .rerun:hover {
    color: var(--fg);
  }

  /* Journey */

  .journey {
    --ring: 2rem;
    position: relative;
    padding-block-start: var(--space-6);
  }

  .rail {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--space-6) + var(--ring) / 2 - 1px);
    height: 2px;
  }

  /* The gates sit at the centers of three equal columns. */
  .seg {
    position: absolute;
    inset-block: 0;
    background: var(--rule);
  }

  .seg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
  }

  :global([dir="rtl"]) .seg::after {
    transform-origin: right;
  }

  .seg-1 {
    inset-inline-start: 16.667%;
    width: 33.333%;
  }

  .seg-2 {
    inset-inline-start: 50%;
    width: 33.333%;
  }

  .dot {
    --x: 83.333%;
    position: absolute;
    top: 50%;
    inset-inline-start: var(--x);
    width: 0.75rem;
    height: 0.75rem;
    margin-block-start: -0.375rem;
    margin-inline-start: -0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--surface);
  }

  .gates {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    list-style: none;
  }

  .gate button {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: 0 var(--space-1);
    background: none;
    border: 0;
    color: inherit;
    text-align: center;
    cursor: default;
    border-radius: var(--radius-sm);
  }

  .ring {
    display: grid;
    place-items: center;
    width: var(--ring);
    height: var(--ring);
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 0 0 4px var(--surface);
  }

  .ring > * {
    grid-area: 1 / 1;
  }

  .ring svg {
    width: 1rem;
    height: 1rem;
  }

  .ring b {
    opacity: 0;
  }

  .gate-name {
    margin-block-start: var(--space-1);
    font-weight: 500;
  }

  .gate-state {
    color: var(--accent);
    font-size: 0.8125rem;
  }

  .passed {
    display: none;
  }

  .details {
    display: grid;
    margin-block-start: var(--space-5);
    min-height: 3.2em;
  }

  .details p {
    grid-area: 1 / 1;
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.6;
    opacity: 0;
    text-align: center;
    max-width: 44ch;
    margin-inline: auto;
  }

  .details p:nth-child(3) {
    opacity: 1;
  }

  /* Pointing at (or focusing) a gate shows its own detail, and pauses the timed one. */
  .journey:has(.gate button:is(:hover, :focus)) .details p {
    animation: none;
    opacity: 0;
  }

  .journey:has(.gate:nth-child(1) button:is(:hover, :focus)) .details p:nth-child(1),
  .journey:has(.gate:nth-child(2) button:is(:hover, :focus)) .details p:nth-child(2),
  .journey:has(.gate:nth-child(3) button:is(:hover, :focus)) .details p:nth-child(3) {
    opacity: 1;
  }

  .gate button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .count {
    --done: 3;
    color: var(--fg);
    font-weight: 500;
    counter-reset: done var(--done);
  }

  .count::before {
    content: counter(done);
  }

  .hint {
    margin-inline-start: auto;
    font-size: 0.8125rem;
  }

  @property --done {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }

  /*
   * Timeline (3.5 s): gate 1 passes at 0.4 s, the change travels to gate 2 and
   * passes at 1.5 s, then to gate 3 and passes at 3.1 s. Delivered at 3.4 s.
   * The delivered state is the default; the run only replays how it got there.
   */
  @media (prefers-reduced-motion: no-preference) {
    .run .dot {
      animation: travel 3500ms linear both;
    }

    .run .seg-1::after {
      animation: grow 1000ms linear 400ms both;
    }

    .run .seg-2::after {
      animation: grow 1000ms linear 2000ms both;
    }

    .run .gate .ring {
      animation: gate-on 320ms var(--ease-out) both;
    }

    .run .gate:nth-child(1) .ring {
      animation-delay: 400ms;
    }
    .run .gate:nth-child(2) .ring {
      animation-delay: 1500ms;
    }
    .run .gate:nth-child(3) .ring {
      animation-delay: 3100ms;
    }

    .run .gate .gate-state {
      animation: arrive 300ms var(--ease-out) both;
    }

    .run .gate:nth-child(1) .gate-state {
      animation-delay: 500ms;
    }
    .run .gate:nth-child(2) .gate-state {
      animation-delay: 1600ms;
    }
    .run .gate:nth-child(3) .gate-state {
      animation-delay: 3200ms;
    }

    /* Each detail shows while the change is at its gate, then hands over to the next. */
    .run .details p:nth-child(1) {
      animation:
        shown 1ms linear 0ms both,
        hide 1ms linear 1400ms forwards;
    }
    .run .details p:nth-child(2) {
      animation:
        shown 1ms linear 1400ms both,
        hide 1ms linear 3000ms forwards;
    }
    .run .details p:nth-child(3) {
      animation: shown 1ms linear 3000ms both;
    }

    .run .done {
      animation: arrive 400ms var(--ease-out) 3400ms both;
    }

    .run .count {
      animation: tally 3500ms linear both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rerun {
      display: none;
    }
  }

  @keyframes travel {
    0%,
    11% {
      --x: 16.667%;
    }
    40%,
    57% {
      --x: 50%;
    }
    86%,
    100% {
      --x: 83.333%;
    }
  }

  @property --x {
    syntax: "<length-percentage>";
    inherits: false;
    initial-value: 16.667%;
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes gate-on {
    from {
      background: var(--surface);
      border-color: var(--rule);
      color: var(--fg-muted);
    }
  }

  .run .gate .ring b {
    animation: shown 1ms linear both reverse;
  }

  .run .gate .ring svg {
    animation: shown 1ms linear both;
  }

  .run .gate:nth-child(1) .ring :is(b, svg) {
    animation-delay: 450ms;
  }
  .run .gate:nth-child(2) .ring :is(b, svg) {
    animation-delay: 1550ms;
  }
  .run .gate:nth-child(3) .ring :is(b, svg) {
    animation-delay: 3150ms;
  }

  @keyframes shown {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
  }

  @keyframes hide {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes tally {
    0%,
    11% {
      --done: 0;
    }
    11.4%,
    42% {
      --done: 1;
    }
    42.4%,
    88% {
      --done: 2;
    }
    88.4%,
    100% {
      --done: 3;
    }
  }

  @media (max-width: 63.99rem) {
    .intro,
    .console {
      grid-column: 1 / -1;
    }

    .hero {
      align-items: flex-start;
    }
  }

  @media (max-width: 39.99rem) {
    .console {
      padding: var(--space-5);
    }

    .gate-state {
      font-size: 0.75rem;
    }

    .hint {
      display: none;
    }
  }
</style>
