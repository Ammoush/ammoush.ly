---
import { profile, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { footer, ui } = profile;
---

<footer class="site-footer tone-dark">
  <div class="shell">
    <p>{footer.copyright[lang]}</p>
    <ul>
      <li><a href="/qr.svg" download="ammoush-ly-qr.svg">{ui.qr[lang]}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--rule);
  }

  ul {
    display: flex;
    margin-inline-start: auto;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--fg);
  }
</style>
