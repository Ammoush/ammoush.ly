---
import "@fontsource-variable/ibm-plex-sans";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile, dir, type Lang } from "../lib/profile";
import themeInit from "../scripts/theme-init.js?raw";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  indexable?: boolean;
}

const { lang, title = profile.meta.title[lang], description = profile.meta.description[lang], indexable = true } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`/og-${lang}.png`, site).href;

const { person, contact } = profile;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name.en,
  jobTitle: person.title.en,
  worksFor: { "@type": "Organization", name: person.organization },
  address: { "@type": "PostalAddress", addressLocality: "Tripoli", addressCountry: "LY" },
  email: `mailto:${contact.email}`,
  url: new URL("/", site).href,
  image: new URL("/og-en.png", site).href,
  sameAs: [contact.linkedin, contact.github].filter(Boolean),
};
---

<!doctype html>
<html lang={lang} dir={dir(lang)} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0e1726" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content={person.name[lang].split(" ")[0]} />
    <meta property="profile:last_name" content={person.name[lang].split(" ").slice(1).join(" ")} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Applies a stored theme choice before first paint; dark is the default. Hashed into the CSP in astro.config.mjs. */}
    <script is:inline set:html={themeInit} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="tone-light">
    <a class="skip-link" href="#main">{profile.ui.skip_to_content[lang]}</a>
    <Header lang={lang} />
    <div class="scroll-progress" aria-hidden="true"></div>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import "../scripts/theme";
      import "../scripts/current-section";
      import "../scripts/copy";
      import "../scripts/backdrop";
    </script>
  </body>
</html>
